config_version=5

[application]
config/name="Alpine Patrol · ROS 2 Simulation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="viewport"

[rendering]
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.09, 0.12, 1)

[physics]
common/physics_ticks_per_second=200
common/max_physics_steps_per_frame=32
3d/default_gravity=9.81


[debug]
file_logging/enable_file_logging=false
